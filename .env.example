BETFAIR_USERNAME=xxx
BETFAIR_PASSWORD=xxx
BETFAIR_APP_KEY=xxx        # Delayed key, usata per screener/paper
BETFAIR_APP_KEY_LIVE=xxx   # Live key — richiede attivazione manuale via supporto Betfair
FOOTBALL_DATA_API_KEY=xxx  # opzionale per il bot: usata solo da backtest/02_fetch_goal_minutes.py

# Percorso ASSOLUTO ai certificati per login non-interattivo (login() via cert_files).
#   - Locale Windows senza Docker: path reale, es. C:/Users/xxx/Documents/Betfair_bot/certs/client-2048.crt
#   - Via Docker (locale o server): SEMPRE /app/certs/... (path dentro il container,
#     non dipende dall'OS host — il bind mount monta l'intero repo su /app)
BETFAIR_CERT_PATH=/app/certs/client-2048.crt
BETFAIR_KEY_PATH=/app/certs/client-2048.key
