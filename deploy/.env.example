# Copia questo file in `.env` (stessa cartella, deploy/.env) e riempilo.
#   cp .env.example .env && chmod 600 .env
# Variabili di DOCKER COMPOSE — non le credenziali Betfair (quelle sono nel .env
# alla root del repo, lette direttamente da python-dotenv dentro il container).

# UID/GID dell'utente host che possiede il repo clonato: `id -u` e `id -g`.
# Senza, i file scritti in logs/ sarebbero di root.
PUID=1000
PGID=1000

# Fuso orario del container.
TZ=Europe/Rome

# Gate live: una strategia con mode="live" in strategies.toml resta comunque in
# paper finche' LIVE non e' true qui. Lasciare false finche' non si e' pronti.
LIVE=false

# Richiesto SOLO se LIVE=true e il container gira senza terminale (sempre il caso
# in produzione): senza, il bot si rifiuta di partire in live invece di procedere
# senza conferma.
CONFIRM_LIVE=

# Tetto di memoria del container. Il server ha RAM stretta e condivisa con altri
# progetti Docker (Frigate, n8n, ib-gateway) — margine ampio per un processo
# Python leggero, non dimensionato a piena capacita'.
BOT_MEM_LIMIT=300m
